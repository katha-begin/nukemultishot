# multishot_switch gizmo
# Automatically selects input based on root.shot matching shot slots
# Input 0 = main (default/fallback)
# Input 1-5 = shotA through shotE
# Each shot slot supports comma-separated shot names (e.g. "SH010, SH020, SH030")

Group {
 name multishot_switch
 inputs 6
 tile_color 0x7f7f7fff
 note_font "Verdana Bold"
 autolabel "n = nuke.thisNode()\ntry:\n    sw = n.node('Switch_main')\n    if sw:\n        w = int(sw\['which'].value())\n        colors = \[0x7f7f7fff, 0xff5555ff, 0x55cc55ff, 0x5588ffff, 0xffcc00ff, 0xcc55ffff]\n        n\['tile_color'].setValue(colors\[w] if w < len(colors) else 0x7f7f7fff)\nexcept: pass\nnuke.thisNode().name()"

 addUserKnob {20 multishot_switch_tab l "Multishot Switch"}

 addUserKnob {26 info_text l "" +STARTLINE T "<b>Shot-based Input Routing</b>\nReads shot name from root.shot and switches to matching input.\nSupports comma-separated shot names (e.g. SH010, SH020)."}
 addUserKnob {26 divider1 l "" +STARTLINE}

 addUserKnob {26 color_legend l "" +STARTLINE T "<font color='#7f7f7f'>■</font> Main (0)  <font color='#ff5555'>■</font> A (1)  <font color='#55cc55'>■</font> B (2)  <font color='#5588ff'>■</font> C (3)  <font color='#ffcc00'>■</font> D (4)  <font color='#cc55ff'>■</font> E (5)"}
 addUserKnob {26 divider_slots l "" +STARTLINE}

 addUserKnob {1 shotA l "<font color='#ff5555'>■</font> Input 1" t "Shot names for Input 1 - RED (comma-separated)"}
 shotA ""
 addUserKnob {22 set_shotA l "Set" t "Add current root.shot to this slot" -STARTLINE T "n = nuke.thisNode()\ntry:\n    shot = nuke.root()\['shot'].value()\n    current = n\['shotA'].value().strip()\n    if current:\n        shots = \[s.strip() for s in current.split(',')]\n        if shot not in shots:\n            shots.append(shot)\n            n\['shotA'].setValue(', '.join(shots))\n    else:\n        n\['shotA'].setValue(shot)\nexcept:\n    nuke.message('Could not read root.shot')"}

 addUserKnob {1 shotB l "<font color='#55cc55'>■</font> Input 2" t "Shot names for Input 2 - GREEN (comma-separated)"}
 shotB ""
 addUserKnob {22 set_shotB l "Set" t "Add current root.shot to this slot" -STARTLINE T "n = nuke.thisNode()\ntry:\n    shot = nuke.root()\['shot'].value()\n    current = n\['shotB'].value().strip()\n    if current:\n        shots = \[s.strip() for s in current.split(',')]\n        if shot not in shots:\n            shots.append(shot)\n            n\['shotB'].setValue(', '.join(shots))\n    else:\n        n\['shotB'].setValue(shot)\nexcept:\n    nuke.message('Could not read root.shot')"}

 addUserKnob {1 shotC l "<font color='#5588ff'>■</font> Input 3" t "Shot names for Input 3 - BLUE (comma-separated)"}
 shotC ""
 addUserKnob {22 set_shotC l "Set" t "Add current root.shot to this slot" -STARTLINE T "n = nuke.thisNode()\ntry:\n    shot = nuke.root()\['shot'].value()\n    current = n\['shotC'].value().strip()\n    if current:\n        shots = \[s.strip() for s in current.split(',')]\n        if shot not in shots:\n            shots.append(shot)\n            n\['shotC'].setValue(', '.join(shots))\n    else:\n        n\['shotC'].setValue(shot)\nexcept:\n    nuke.message('Could not read root.shot')"}

 addUserKnob {1 shotD l "<font color='#ffcc00'>■</font> Input 4" t "Shot names for Input 4 - YELLOW (comma-separated)"}
 shotD ""
 addUserKnob {22 set_shotD l "Set" t "Add current root.shot to this slot" -STARTLINE T "n = nuke.thisNode()\ntry:\n    shot = nuke.root()\['shot'].value()\n    current = n\['shotD'].value().strip()\n    if current:\n        shots = \[s.strip() for s in current.split(',')]\n        if shot not in shots:\n            shots.append(shot)\n            n\['shotD'].setValue(', '.join(shots))\n    else:\n        n\['shotD'].setValue(shot)\nexcept:\n    nuke.message('Could not read root.shot')"}

 addUserKnob {1 shotE l "<font color='#cc55ff'>■</font> Input 5" t "Shot names for Input 5 - PURPLE (comma-separated)"}
 shotE ""
 addUserKnob {22 set_shotE l "Set" t "Add current root.shot to this slot" -STARTLINE T "n = nuke.thisNode()\ntry:\n    shot = nuke.root()\['shot'].value()\n    current = n\['shotE'].value().strip()\n    if current:\n        shots = \[s.strip() for s in current.split(',')]\n        if shot not in shots:\n            shots.append(shot)\n            n\['shotE'].setValue(', '.join(shots))\n    else:\n        n\['shotE'].setValue(shot)\nexcept:\n    nuke.message('Could not read root.shot')"}

 addUserKnob {26 divider2 l "" +STARTLINE}
 addUserKnob {22 clear_all l "Clear All Shots" t "Clear all shot slots" T "n = nuke.thisNode()\nfor slot in \['shotA', 'shotB', 'shotC', 'shotD', 'shotE']:\n    n\[slot].setValue('')"}

 addUserKnob {26 divider3 l "" +STARTLINE}
 addUserKnob {26 current_shot_label l "Current root.shot:" T ""}
 addUserKnob {1 current_shot_display l "" +DISABLED}
 current_shot_display "\[value root.shot]"
 addUserKnob {26 active_input_label l "Active Input:" T ""}
 addUserKnob {3 active_input_display l "" +DISABLED}
 active_input_display 0
}
 Input {
  inputs 0
  name Input5
  xpos 750
  ypos -200
 }
 Input {
  inputs 0
  name Input4
  xpos 600
  ypos -200
 }
 Input {
  inputs 0
  name Input3
  xpos 450
  ypos -200
 }
 Input {
  inputs 0
  name Input2
  xpos 300
  ypos -200
 }
 Input {
  inputs 0
  name Input1
  xpos 150
  ypos -200
 }
 Input {
  inputs 0
  name Input0
  xpos 0
  ypos -200
 }
 Switch {
  inputs 6
  which {{"\[expr \{\[lsearch \[split \[string map \{\", \" \",\"\} \[value parent.shotA]] \",\"] \[value root.shot]] >= 0 ? 1 : \[lsearch \[split \[string map \{\", \" \",\"\} \[value parent.shotB]] \",\"] \[value root.shot]] >= 0 ? 2 : \[lsearch \[split \[string map \{\", \" \",\"\} \[value parent.shotC]] \",\"] \[value root.shot]] >= 0 ? 3 : \[lsearch \[split \[string map \{\", \" \",\"\} \[value parent.shotD]] \",\"] \[value root.shot]] >= 0 ? 4 : \[lsearch \[split \[string map \{\", \" \",\"\} \[value parent.shotE]] \",\"] \[value root.shot]] >= 0 ? 5 : 0\}]"}}
  name Switch_main
  xpos 0
  ypos -100
 }
 Output {
  name Output1
  xpos 0
  ypos 0
 }
end_group

