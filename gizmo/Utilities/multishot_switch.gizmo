# multishot_switch gizmo
# Dynamic shot-based input routing
# - Starts with 1 input (main/default)
# - User clicks "Add Shot Input" to add more inputs
# - Each input supports multiple shot names separated by comma
# - If root.shot matches any shot name, routes to that input

Group {
 name multishot_switch
 tile_color 0x7f7f7fff
 note_font "Verdana Bold"

 addUserKnob {20 multishot_switch_tab l "Multishot Switch"}
 addUserKnob {26 info_text l "" +STARTLINE T "<b>Shot-based Input Routing</b>\nInput 0 = Default/Main (fallback)\nClick 'Add Shot Input' to create new inputs.\nEach input supports multiple shots (comma-separated)."}
 addUserKnob {26 divider1 l "" +STARTLINE}

 addUserKnob {26 status_label l "root.shot:" T ""}
 addUserKnob {26 current_shot l "" +STARTLINE T "<b>\[value root.shot]</b>"}
 addUserKnob {26 divider2 l "" +STARTLINE}

 addUserKnob {3 input_count l "Input Count" t "Number of shot inputs (excluding main)"}
 input_count 0

 addUserKnob {22 add_input_btn l "Add Shot Input" t "Add a new shot input with shot name field" T "from multishot.nodes.switch_node import add_shot_input; add_shot_input(nuke.thisNode())"}

 addUserKnob {22 update_switch_btn l "Update Switch" t "Rebuild internal switch based on current inputs" T "from multishot.nodes.switch_node import update_switch; update_switch(nuke.thisNode())"}

 addUserKnob {26 divider3 l "" +STARTLINE}
 addUserKnob {22 remove_last_btn l "Remove Last Input" t "Remove the last shot input" T "from multishot.nodes.switch_node import remove_last_input; remove_last_input(nuke.thisNode())"}

 addUserKnob {26 divider4 l "" +STARTLINE}
 addUserKnob {22 set_shot_btn l "Set from root.shot" t "Add current root.shot to last input" T "from multishot.nodes.switch_node import set_shot_from_root; set_shot_from_root(nuke.thisNode())"}
}

 Input {
  inputs 0
  name Input0
  label "main (default)"
  xpos 0
  ypos -200
 }
 Switch {
  inputs 1
  which 0
  name ShotSwitch
  xpos 0
  ypos -50
 }
 Output {
  name Output1
  xpos 0
  ypos 50
 }
end_group

